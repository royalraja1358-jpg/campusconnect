# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://campususer:campuspass@localhost:5432/campusconnect

# ─── JWT ────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Email (for forgot password) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CampusConnect <your-email@gmail.com>

# ─── App ────────────────────────────────────────────────────
APP_NAME=CampusConnect
FRONTEND_URL=http://localhost:5500
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
